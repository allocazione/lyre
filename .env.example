# Lyre Configuration
# Copy this file to .env and fill in the values.
# Sensitive values (tokens, API keys) are automatically encrypted
# by the first-run wizard with the ENC: prefix.
# You can also encrypt an existing config with: python -m lyre --encrypt-config

# -- Misskey / Mastodon --
MISSKEY_INSTANCE_URL=https://misskey.example.com
MISSKEY_TOKEN=your_misskey_api_token_here

# -- Music Provider --
# Choose one: 'lastfm' or 'statsfm'
MUSIC_PROVIDER=lastfm

# -- Last.fm (required if MUSIC_PROVIDER=lastfm) --
LASTFM_API_KEY=your_lastfm_api_key
LASTFM_API_SECRET=your_lastfm_api_secret
LASTFM_USERNAME=your_lastfm_username

# -- Stats.fm (required if MUSIC_PROVIDER=statsfm) --
STATSFM_USERNAME=your_statsfm_username

# -- Bot Settings --
UPDATE_BIO=true
POST_NOTES=true
POLL_INTERVAL=30
